VALKEY_URL=redis://localhost:6379
TIMESCALE_DSN=postgresql://postgres:postgres@localhost:5432/cryptoswarm_ts
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/cryptoswarm
BINANCE_API_KEY=your_testnet_key
BINANCE_API_SECRET=your_testnet_secret
BINANCE_TESTNET=true
PAPER_TRADING=true
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT
RISK__STARTING_BALANCE_USD=1000.0
RISK__MAX_POSITION_PCT=0.10
RISK__MAX_CONCURRENT_POSITIONS=5
RISK__MAX_LEVERAGE=5
RISK__DAILY_LOSS_PCT=0.03
RISK__MAX_DRAWDOWN_PCT=0.15

# ── Dashboard auth (REQUIRED — the backend refuses to start on defaults) ──
# Generate a strong secret:  openssl rand -hex 32
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-strong-unique-password
DASHBOARD_SECRET_KEY=change-me-openssl-rand-hex-32
# Production: set a bcrypt hash instead of a plaintext password (takes
# precedence over DASHBOARD_PASSWORD, which can then be left blank).
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpass'))"
# DASHBOARD_PASSWORD_HASH=
# Set to true once the dashboard is served over HTTPS (Secure cookie flag).
COOKIE_SECURE=false

# ── LLM / OpenRouter (used for agents + news search via Perplexity Sonar) ──
OPENROUTER_API_KEY=your_openrouter_key
LLM_PROVIDER=openrouter
